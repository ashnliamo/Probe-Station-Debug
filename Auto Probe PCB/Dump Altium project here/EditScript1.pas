// ---------------------------------------------------------------------------
// Diagnostic 1 (PREFERRED): print the active library's registered path.
//
// This is the string to paste into STALE_LIB_PATH. Run it while the library is
// open and focused, BEFORE you close and delete it. DocumentName is exactly
// how Altium registered the document, so it is guaranteed to match what
// GetDocumentByPath expects -- no transcription risk.
// ---------------------------------------------------------------------------
Procedure ShowCurrentLibPath;
Var
    D : ISch_Document;
Begin
    If SchServer = Nil Then
    Begin
        ShowMessage('SchServer is nil -- the schematic editor is not loaded.');
        Exit;
    End;

    D := SchServer.GetCurrentSchDocument;
    If D = Nil Then
    Begin
        ShowMessage('No schematic document is focused. Click into the .SchLib ' +
            'editor tab and run again.');
        Exit;
    End;

    ShowMessage('Registered path of the active document:' + #13#10#13#10 +
        D.DocumentName + #13#10#13#10 +
        'Copy this into STALE_LIB_PATH exactly as shown.');
End;


// ---------------------------------------------------------------------------
// Diagnostic 2: enumerate documents Altium has loaded, via the workspace.
//
// Standalone (non-project) documents live under a pseudo-project named
// 'Free Documents'. Note this lists documents the workspace knows about --
// a cached document that has been detached from the workspace may not appear
// here even though GetDocumentByPath still returns it. The definitive cache
// test is CloseStaleLibrary itself: if it reports 'No cached document', the
// cache is clean for that path.
// ---------------------------------------------------------------------------
Procedure ListOpenDocuments;
Var
    WS   : IWorkspace;
    Prj  : IProject;
    Doc  : IDocument;
    I, J : Integer;
    Rpt  : TStringList;
Begin
    WS := GetWorkspace;
    If WS = Nil Then
    Begin
        ShowMessage('No workspace available.');
        Exit;
    End;

    Rpt := TStringList.Create;
    Try
        Rpt.Add('Projects: ' + IntToStr(WS.DM_ProjectCount));
        Rpt.Add('');

        For I := 0 To WS.DM_ProjectCount - 1 Do
        Begin
            Prj := WS.DM_Projects(I);
            If Prj <> Nil Then
            Begin
                Rpt.Add('=== ' + Prj.DM_ProjectFileName + ' ===');

                For J := 0 To Prj.DM_LogicalDocumentCount - 1 Do
                Begin
                    Doc := Prj.DM_LogicalDocuments(J);
                    If Doc <> Nil Then
                        Rpt.Add('  [' + Doc.DM_DocumentKind + '] ' +
                                Doc.DM_FullPath);
                End;

                Rpt.Add('');
            End;
        End;

        Rpt.Add('---');
        Rpt.Add('Copy any SCHLIB path above into STALE_LIB_PATH byte-for-byte.');
        Rpt.Add('If the library is currently open, ShowCurrentLibPath is more');
        Rpt.Add('reliable -- it reads the path straight off the document.');
        ShowMessage(Rpt.Text);
    Finally
        Rpt.Free;
    End;
End;


// ---------------------------------------------------------------------------
// Close one cached document by path. Returns a human-readable status line.
// ---------------------------------------------------------------------------
Function CloseOneDocument(APath : String) : String;
Var
    ServerDoc  : IServerDocument;
    CanCloseIt : Boolean;
Begin
    ServerDoc := Client.GetDocumentByPath(APath);

    If ServerDoc = Nil Then
    Begin
        // Nil means no cached copy -- the good outcome, not an error.
        Result := 'not cached (already clean)';
        Exit;
    End;

    // If Altium is already tearing this document down, do not interfere.
    If ServerDoc.GetBeingClosed Then
    Begin
        Result := 'SKIPPED - already mid-close';
        Exit;
    End;

    ServerDoc.SetModified(False);   // suppress the save prompt

    CanCloseIt := ServerDoc.GetCanClose;
    If CanCloseIt = False Then
    Begin
        If FORCE_BEING_CLOSED Then
            // Flag as mid-destruction so CloseDocument will go through.
            // See the warning on the const before enabling this.
            ServerDoc.SetBeingClosed(True)
        Else
        Begin
            Result := 'BLOCKED - CanClose=False (open tab or project holds it)';
            Exit;
        End;
    End;

    Client.CloseDocument(ServerDoc);

    // Verify the eviction took, rather than assuming it did.
    If Client.GetDocumentByPath(APath) <> Nil Then
    Begin
        Result := 'FAILED - still cached after CloseDocument; restart Altium';
        Exit;
    End;

    If DELETE_AFTER_CLOSE Then
        If FileExists(APath) Then
            DeleteFile(APath);

    Result := 'CLOSED';
End;


// ---------------------------------------------------------------------------
// Stale-document eviction. Run on its own, before creating the new library.
//
// Self-discovering: walks the workspace for SCHLIB documents rather than
// making you transcribe a path. By default it only touches libraries whose
// file is MISSING from disk -- a library Altium still has registered but that
// no longer exists on disk is stale by definition, and that is precisely the
// delete-then-regenerate case. Libraries you are actively using are left
// alone because their files still exist.
//
// STALE_LIB_PATH, if set, is always processed in addition to whatever the
// scan finds, and bypasses the missing-file filter.
// ---------------------------------------------------------------------------
Procedure CloseStaleLibrary;
Var
    WS       : IWorkspace;
    Prj      : IProject;
    Doc      : IDocument;
    I, J     : Integer;
    Cands    : TStringList;
    Rpt      : TStringList;
    P        : String;
    Status   : String;
    Wanted   : Boolean;
    NumClosed: Integer;
Begin
    Cands := TStringList.Create;
    Rpt   := TStringList.Create;
    Try
        // Explicit override first -- bypasses the missing-file filter.
        If STALE_LIB_PATH <> '' Then
            Cands.Add(STALE_LIB_PATH);

        // Scan the workspace for schematic libraries.
        WS := GetWorkspace;
        If WS <> Nil Then
        Begin
            For I := 0 To WS.DM_ProjectCount - 1 Do
            Begin
                Prj := WS.DM_Projects(I);
                If Prj <> Nil Then
                Begin
                    For J := 0 To Prj.DM_LogicalDocumentCount - 1 Do
                    Begin
                        Doc := Prj.DM_LogicalDocuments(J);
                        If Doc <> Nil Then
                        Begin
                            If UpperCase(Doc.DM_DocumentKind) = 'SCHLIB' Then
                            Begin
                                P := Doc.DM_FullPath;

                                // Stale == registered but gone from disk.
                                // Computed stepwise; DelphiScript's parser is
                                // unreliable with compound And/Or conditions.
                                Wanted := True;
                                If CLOSE_ONLY_MISSING_FILES Then
                                    If FileExists(P) Then
                                        Wanted := False;

                                If Wanted Then
                                    If Cands.IndexOf(P) < 0 Then
                                        Cands.Add(P);
                            End;
                        End;
                    End;
                End;
            End;
        End;

        If Cands.Count = 0 Then
        Begin
            ShowMessage('No stale schematic libraries found.' + #13#10#13#10 +
                'Either the cache is clean, or the cached document has been ' +
                'detached from the workspace and the scan cannot see it. ' +
                'In that case run ShowCurrentLibPath while the library is ' +
                'open, put the path in STALE_LIB_PATH, and re-run.');
            Exit;
        End;

        NumClosed := 0;
        Rpt.Add('Stale library candidates: ' + IntToStr(Cands.Count));
        Rpt.Add('');

        For I := 0 To Cands.Count - 1 Do
        Begin
            P := Cands.Strings[I];
            Status := CloseOneDocument(P);
            If Status = 'CLOSED' Then NumClosed := NumClosed + 1;
            Rpt.Add(P);
            Rpt.Add('  -> ' + Status);
            Rpt.Add('');
        End;

        Rpt.Add('---');
        Rpt.Add('Closed: ' + IntToStr(NumClosed));
        If NumClosed > 0 Then
            Rpt.Add('Now create the new library, make it active, run GenerateSymbol.');

        ShowMessage(Rpt.Text);
    Finally
        Cands.Free;
        Rpt.Free;
    End;
End;



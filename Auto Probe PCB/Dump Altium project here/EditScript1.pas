// ---------------------------------------------------------------------------
// Idempotency: strip any pre-existing copies of COMP_NAME from the library.
//
// The iterator is re-created after every removal. Mutating a library while an
// Altium iterator is live over it is unreliable -- the "cache Next, then
// remove" pattern still leaves the iterator pointing into a container that
// changed underneath it, which silently skips entries and lets a copy survive.
// ---------------------------------------------------------------------------
Function RemoveExisting : Integer;
Var
    It     : ISch_Iterator;
    Cmp    : ISch_Component;
    Victim : ISch_Component;
    Guard  : Integer;
    Done   : Boolean;
Begin
    Result := 0;
    Guard  := 0;

    Repeat
        Victim := Nil;

        It := Lib.SchLibIterator_Create;
        If It = Nil Then Break;
        Try
            It.AddFilter_ObjectSet(MkSet(eSchComponent));
            Cmp := It.FirstSchObject;
            While Cmp <> Nil Do
            Begin
                If Cmp.LibReference = COMP_NAME Then
                Begin
                    Victim := Cmp;
                    Break;
                End;
                Cmp := It.NextSchObject;
            End;
        Finally
            Lib.SchIterator_Destroy(It);
        End;

        If Victim <> Nil Then
        Begin
            Lib.RemoveSchComponent(Victim);
            Result := Result + 1;
        End;

        Guard := Guard + 1;

        // Loop exit computed stepwise rather than as a compound Or.
        Done := False;
        If Victim = Nil Then Done := True;
        If Guard > 500 Then Done := True;
    Until Done;
End;


// ---------------------------------------------------------------------------
// Main entry point
// ---------------------------------------------------------------------------
Procedure GenerateSymbol;
Var
    Impl;
    Removed : Integer;
    Warn    : String;
Begin
    If SchServer = Nil Then
    Begin
        ShowMessage('SchServer is nil -- the schematic editor is not loaded.');
        Exit;
    End;

    Lib := SchServer.GetCurrentSchDocument;
    If Lib = Nil Then
    Begin
        ShowMessage('No schematic library open. Create one first: ' +
            'File > New > Library > Schematic Library, make it active, then run again.');
        Exit;
    End;

    // Guard against a .SchDoc being focused instead of a .SchLib --
    // AddSchComponent on a plain sheet fails in confusing ways.
    If Lib.ObjectID <> eSchLib Then
    Begin
        ShowMessage('The active document is not a schematic library. ' +
            'Focus the .SchLib tab and run again.');
        Exit;
    End;

    SchServer.ProcessControl.PreProcess(Lib, '');
    Try
        Removed := RemoveExisting;

        Comp := SchServer.SchObjectFactory(eSchComponent, eCreate_GlobalCopy);
        Comp.LibReference := COMP_NAME;
        Comp.ComponentDescription := 'Probe card -- one part per net class';
        Comp.Designator.Text := 'PC?';
        Comp.PartCount := 5;
        Comp.DisplayMode := 0;

        BuildPart1;
        BuildPart2;
        BuildPart3;
        BuildPart4;
        BuildPart5;

        Impl := Comp.AddSchImplementation;
        Impl.ModelName := FP_NAME;
        Impl.ModelType := 'PCBLIB';
        Impl.IsCurrent := True;

        Lib.AddSchComponent(Comp);
        Lib.CurrentSchComponent := Comp;

        // Register the new component so the SCH Library panel refreshes
        // instead of showing a stale component list.
        SchServer.RobotManager.SendMessage(Lib.I_ObjectAddress, c_BroadCast,
            SCHM_PrimitiveRegistration, Comp.I_ObjectAddress);

        Comp.GraphicallyInvalidate;
    Finally
        SchServer.ProcessControl.PostProcess(Lib, '');
    End;

    If Removed > 0 Then
        Warn := #13#10#13#10 +
            'Pre-existing copies were found and removed. If you created this ' +
            'library from scratch just now, Altium handed you a CACHED ' +
            'document -- that is your duplicate source. Run ListOpenDocuments ' +
            'and CloseStaleLibrary before the next run.'
    Else
        Warn := '';

    ShowMessage('Component ' + COMP_NAME + ' built in ' + Lib.DocumentName +
        #13#10 + 'Pre-existing copies removed: ' + IntToStr(Removed) +
        #13#10#13#10 + 'Save the .SchLib.' + Warn);
End;

Procedure GenerateSchematic;
Begin
    If SchServer = Nil Then
    Begin
        ShowMessage('SchServer is nil -- the schematic editor is not loaded.');
        Exit;
    End;
    Doc := SchServer.GetCurrentSchDocument;
    If Doc = Nil Then
    Begin
        ShowMessage('No schematic is open. Create a blank one first: ' +
            'File > New > Schematic, make that tab active, then run again.');
        Exit;
    End;
    SchServer.ProcessControl.PreProcess(Doc, '');
    BuildBlock0;
    BuildBlock1;
    BuildBlock2;
    BuildBlock3;
    BuildBlock4;
    SchServer.ProcessControl.PostProcess(Doc, '');
    Doc.GraphicallyInvalidate;
    ShowMessage('Net-class schematic built on the active sheet. ' +
        'Use File > Save As to save it as a .SchDoc.');
End;
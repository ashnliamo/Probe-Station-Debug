// Auto-generated by auto_probe_pcb.py -- Altium schematic DelphiScript.
// Build a blank schematic first: File > New > Schematic, make that tab the
// ACTIVE document, then File > Run Script... and run GenerateSchematic.
// Produces one vertical block per net class; each pin is one probe land,
// pin designator = land id (B1, L5...), pin name = the die signal.
// A standalone sheet -- drop it into your project and add components freely.

Var
    Doc : ISch_Document;

// --- one rectangular net-class block, pins stubbed out to the left.
// --- Scripted Sch primitives MUST carry OwnerPartId/OwnerPartDisplayMode
// --- matching the component's CurrentPartID/DisplayMode, or Altium drops
// --- them onto the component origin instead of their set locations.
Function NewBlock(Xmil, Ymil, Wmil, Hmil : Integer; Comment : String) : ISch_Component;
Var Comp, R;
Begin
    Comp := SchServer.SchObjectFactory(eSchComponent, eCreate_GlobalCopy);
    Comp.Location := Point(MilsToCoord(Xmil), MilsToCoord(Ymil));
    Comp.CurrentPartID := 1;
    Comp.DisplayMode := 0;
    Comp.Designator.Text := Comment;
    Comp.Designator.IsHidden := False;
    Comp.Comment.Text := Comment;
    Comp.Comment.IsHidden := True;
    R := SchServer.SchObjectFactory(eRectangle, eCreate_GlobalCopy);
    R.OwnerPartId := Comp.CurrentPartID;
    R.OwnerPartDisplayMode := Comp.DisplayMode;
    R.Location := Point(MilsToCoord(Xmil), MilsToCoord(Ymil - Hmil));
    R.Corner := Point(MilsToCoord(Xmil + Wmil), MilsToCoord(Ymil));
    R.LineWidth := eSmall;
    R.IsSolid := True;
    R.AreaColor := $00E7FFFF;
    R.Color := $00000080;
    Comp.AddSchObject(R);
    Result := Comp;
End;

// --- add one probe land as a left-side pin on the block. Xmil is the block's
// --- left edge; the pin hot-spot sits one PinLength further left so the stub
// --- sticks out. Left-side pins use eRotate0 (pin points right into the body).
Procedure AddPin(Comp : ISch_Component; Xmil, Ymil : Integer; Desig, Nm : String);
Var Pin;
Begin
    Pin := SchServer.SchObjectFactory(ePin, eCreate_GlobalCopy);
    Pin.OwnerPartId := Comp.CurrentPartID;
    Pin.OwnerPartDisplayMode := Comp.DisplayMode;
    Pin.Orientation := eRotate0;
    Pin.Location := Point(MilsToCoord(Xmil - 300), MilsToCoord(Ymil));
    Pin.PinLength := MilsToCoord(300);
    Pin.Designator := Desig;
    Pin.Name := Nm;
    Pin.ShowName := True;
    Pin.ShowDesignator := True;
    Pin.Electrical := eElectricPassive;
    Comp.AddSchObject(Pin);
End;

// --- free-text title above a block (full net-class name; may contain spaces).
Procedure AddTitle(Xmil, Ymil : Integer; S : String);
Var T;
Begin
    T := SchServer.SchObjectFactory(eLabel, eCreate_GlobalCopy);
    T.Location := Point(MilsToCoord(Xmil), MilsToCoord(Ymil));
    T.Text := S;
    T.FontID := 1;
    Doc.RegisterSchObjectInContainer(T);
    SchServer.RobotManager.SendMessage(Doc.I_ObjectAddress, c_BroadCast,
        SCHM_PrimitiveRegistration, T.I_ObjectAddress);
End;

Procedure Commit(Comp : ISch_Component);
Begin
    Doc.RegisterSchObjectInContainer(Comp);
    SchServer.RobotManager.SendMessage(Doc.I_ObjectAddress, c_BroadCast,
        SCHM_PrimitiveRegistration, Comp.I_ObjectAddress);
End;


